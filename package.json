{
  "name": "save-my",
  "version": "0.1.0",
  "description": "A graph-first business continuity workspace with native WebMCP Site Tools.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Artem Musii",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artem-musii/save-my.git"
  },
  "bugs": {
    "url": "https://github.com/artem-musii/save-my/issues"
  },
  "homepage": "https://github.com/artem-musii/save-my#readme",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"bun --watch src/server/index.ts\" \"vite\"",
    "dev:api": "bun --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "bun src/server/index.ts",
    "test": "bun test src",
    "test:coverage": "bun test src --coverage",
    "test:e2e": "playwright test",
    "video:record": "bun scripts/record-demo.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "db:migrate": "bun src/infrastructure/database/migrate.ts",
    "audit": "bun audit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/martian-mono": "^5.2.8",
    "@hono/zod-validator": "^0.7.2",
    "hono": "^4.9.6",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "axe-core": "^4.10.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3"
  }
}
